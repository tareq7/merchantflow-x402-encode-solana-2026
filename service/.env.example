# MerchantFlow x402 V2 — Service environment (devnet)
# REQUIRED: Solana devnet recipient address that will receive USDC payments via x402.
# Generate a devnet keypair: solana-keygen new --no-outfile --no-bip39-passphrase
# Never commit real keys. This address must have an associated USDC token account (ATA) on devnet
# before settlement can succeed — see docs/REAL_X402_V2_STATUS.md for ATA prerequisite.
SOLANA_PAY_TO=So11111111111111111111111111111111111111112
# REQUIRED: x402 facilitator URL that supports solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 with scheme "exact".
# Use the public test facilitator for devnet experiments, or run your own.
# The service verifies facilitator capabilities on startup and fails closed if unsupported.
FACILITATOR_URL=https://x402.org/facilitator
# Optional: override price for GET /api/merchant/inventory (default $0.01 USDC)
X402_PRICE=$0.01
# Optional: server port (default 3001)
PORT=3001
